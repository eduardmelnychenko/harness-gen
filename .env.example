# Required by the web application. Replace both placeholders with generated keys.
DJANGO_SECRET_KEY=replace-with-a-generated-key
HARNESS_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Enable only for local development over HTTP.
HARNESS_DEBUG=true

# Optional application settings.
# HARNESS_CREATOR_LOG_LEVEL=INFO
# HARNESS_DJANGO_DB=data/web.sqlite3
# HARNESS_DB_URL=sqlite:///data/harness.db
# HARNESS_WORKSPACE_ROOT=workspaces
# HARNESS_ALLOWED_HOSTS=localhost,127.0.0.1
# HARNESS_CSRF_TRUSTED_ORIGINS=

# Optional provider settings for the CLI. Web accounts configure providers in
# the application. The default CLI provider is local Ollama (llama3.2).
# HARNESS_LLM_PROVIDER=ollama
# HARNESS_LLM_MODEL=llama3.2
# HARNESS_OLLAMA_BASE_URL=http://localhost:11434
#
# For OpenAI:
# HARNESS_LLM_PROVIDER=openai
# HARNESS_LLM_MODEL=
# OPENAI_API_KEY=
# HARNESS_OPENAI_BASE_URL=https://api.openai.com/v1
#
# For Azure OpenAI:
# HARNESS_LLM_PROVIDER=azure_openai
# HARNESS_LLM_MODEL=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-10-21
#
# For Meta's hosted API:
# HARNESS_LLM_PROVIDER=meta
# HARNESS_LLM_MODEL=
# LLAMA_API_KEY=
# HARNESS_META_BASE_URL=https://api.llama.com/compat/v1
#
# For Google Gemini:
# HARNESS_LLM_PROVIDER=google_gemini
# HARNESS_LLM_MODEL=
# GOOGLE_API_KEY=
#
# For Anthropic Claude:
# HARNESS_LLM_PROVIDER=anthropic
# HARNESS_LLM_MODEL=
# ANTHROPIC_API_KEY=
